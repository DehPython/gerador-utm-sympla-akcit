# Copie para .env e preencha. O .env não vai para o repositório.
#
#   cp .env.example .env

# Chave de autenticação do Tailscale, para o endereço fixo com HTTPS.
# Gere em: login.tailscale.com/admin/settings/keys > Generate auth key
# Marque "Reusable" e deixe "Ephemeral" desmarcado.
TS_AUTHKEY=

# Porta local. Com o Tailscale ativo ela deixa de ser publicada no host.
PORTA=8080

# Minutos entre uma leitura da planilha e a próxima, em segundos.
INTERVALO=600
