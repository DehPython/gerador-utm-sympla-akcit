# Mantém /dados/dados.js em dia com a planilha. Só sai para a internet no
# domínio do Google Sheets e só escreve nesse arquivo.
FROM node:22-alpine

WORKDIR /app
COPY package.json ./
COPY src/planilha.js src/dados.js ./src/
COPY scripts/sincronizar.js scripts/sincronizar-sempre.sh ./scripts/

ENV DADOS_PATH=/dados/dados.js
ENV INTERVALO=600

USER node

CMD ["sh", "scripts/sincronizar-sempre.sh"]
